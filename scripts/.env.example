# --- Google Places API (find_leads.py) ---
# Consola: https://console.cloud.google.com → habilitar "Places API (New)"
GOOGLE_PLACES_API_KEY=

# --- Claude API (personalize.py) ---
ANTHROPIC_API_KEY=

# --- SMTP (send_campaign.py) — un bloque por buzón de envío ---
# Google Workspace: smtp.gmail.com:587 con contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dani@devlop-web.com
SMTP_PASS=
REMITENTE_NOMBRE=Dani de dev.lop

# Límite de envíos por ejecución (protección de entregabilidad)
MAX_ENVIOS_DIA=40
